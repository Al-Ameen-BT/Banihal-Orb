[Unit]
Description=Tech B2B SaaS Backend API Server
After=network.target postgresql.service ollama.service
Wants=ollama.service
Documentation=https://github.com/Al-Ameen-BT/B2B-Site

[Service]
Type=simple
# User running the service — should be a dedicated unprivileged system user
User=b2bapp
WorkingDirectory=/opt/B2B-Site/server
# Loads environment variables from the server/.env file. The '-' prefix ignores the file if missing.
EnvironmentFile=-/opt/B2B-Site/server/.env
# Default environment variables
Environment=NODE_ENV=production
Environment=PORT=3001
# Use /usr/bin/env node to resolve node via PATH (supports NVM, FNM, system node, etc.)
ExecStart=/usr/bin/env node dist/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=b2b-api

# ─── Security Hardening (least-privilege sandbox) ─────────────────────────────
NoNewPrivileges=yes
ProtectSystem=full
# NOTE: Set ProtectHome=no if the application directory resides under /home/
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
