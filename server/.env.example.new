# ── Slack Webhook ────────────────────────────────────────────────────────────
# Webhook URL for publishing proxy configuration changes.
# Set this to your Slack incoming webhook URL.
# Format: https://slack-webhook.example.invalid/replace-with-your-webhook
SLACK_WEBHOOK_URL=""

# ── Slack Webhook Sender Settings ────────────────────────────────────────────
# Username that appears as the sender in Slack messages
SLACK_WEBHOOK_USERNAME="Squid Proxy Bot"
# Emoji icon for the sender
SLACK_WEBHOOK_ICON_EMOJI=":robot_face:"