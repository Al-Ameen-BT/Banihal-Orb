# Database
DATABASE_URL="postgresql://user:password@localhost:5432/b2b_saas?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS — comma-separated list of allowed frontend origins (scheme + host + port).
# MUST include the exact origin the browser loads the app from. For a LAN deploy
# accessed by IP, use that IP (and include localhost too if you also test locally):
#   ALLOWED_ORIGINS="http://172.17.121.200:3000,http://localhost:3000"
# Use "*" to allow any origin (LAN/dev convenience; the origin is still reflected
# for credentialed requests).
ALLOWED_ORIGINS="http://localhost:3000"

# Comma-separated work-email domains for the software provider — only these may hold
# and log in with the ADMINISTRATOR role. REQUIRED: if empty, admin login is disabled
# (fail closed). Must include the domain of any seeded/provisioned admin.
ADMIN_DOMAINS="platform.com"

# Cookie Secure flag. MUST be "false" when serving over plain HTTP (e.g. a LAN IP),
# otherwise the browser silently drops the auth cookie and every login "fails".
# Set to "true" only when served over HTTPS.
COOKIE_SECURE="true"

# Optional: internal impersonation signing secret
IMPERSONATION_SECRET="change-me-impersonation-secret-min-32-chars"

# Encrypts Slack bot tokens, incoming-webhook URLs, and AD temporary passwords at
# rest (AES-256-GCM). OPTIONAL: falls back to JWT_ACCESS_SECRET when unset.
# ⚠ BACK THIS UP. If it is lost or changed, every previously encrypted bot token,
# webhook, and delivered AD credential becomes permanently undecryptable.
SLACK_TOKEN_SECRET="change-me-slack-token-secret-min-32-chars"

# Public URL of the frontend — used to build links in outgoing emails (password
# reset). Must be the exact origin users load the app from.
FRONTEND_URL="http://localhost:3000"

# Single-session enforcement: a session idle longer than this (minutes) no longer
# blocks a fresh login, so a closed browser can't lock the account for 7 days.
SESSION_INACTIVITY_MINUTES=30

# Chatbot backend — Analytics Agent (SSE) on the same host; /api/chat proxies to it
AGENT_URL="http://localhost:8001"

# Legacy Ollama settings (the agent manages its own model now; used by the deploy preflight)
OLLAMA_URL="http://localhost:11435"
OLLAMA_MODEL="qwen2.5:3b"

# Split databases — chat history and the ticketing tool each use their own DB
CHAT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_chat"
TICKETING_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_ticketing"

# Platform ADMINISTRATOR ticketing uses a SEPARATE database (same Ticket/Project
# schema as TICKETING_DATABASE_URL) so the provider's admins keep an isolated
# ticket store from org/user tickets. OPTIONAL: if unset, ADMINISTRATOR requests
# fall back to TICKETING_DATABASE_URL (no separate store). Create it with:
#   sudo -u postgres createdb b2b_ticketing_admin
#   cd server && npx prisma db push --schema prisma/ticketing.prisma   # after pointing the URL at it
ADMIN_TICKETING_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_ticketing_admin"

# Full Ticketing Platform database — the 14-table schema (Users/Customers/Projects/
# Tickets/SLAs/Comments/Activities/…) that backs the rebuilt ticketing module.
# Create + load with: server/prisma/ticketing-full-schema.sql, then introspect via
#   npx prisma db pull --schema prisma/ticket.prisma
TICKET_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_ticket"

# Mailing System (SMTP Config)
# REQUIRED in practice: every login sends a 6-digit MFA code by email, so if mail
# cannot be sent, NO ONE can log in. Verify with a real end-to-end login.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="noreply@b2bsaas.com"

# Email MFA tuning (a 6-digit code is required on every login).
# TTL of a code, max wrong attempts before the challenge is burned, resend cooldown.
MFA_CODE_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
MFA_RESEND_COOLDOWN_SECONDS=30

# Directory for ticket/comment attachment uploads (local disk, relative to cwd).
# ⚠ Put this on a PERSISTENT volume in production — a rebuild/redeploy of the tree
# will otherwise lose uploaded files.
UPLOAD_DIR="uploads"

# External ticketing API (optional mirror/sync). The integration stays fully
# DISABLED while TICKETING_API_URL is unset — local tickets work standalone.
# TICKETING_API_URL="https://tickets.example.com/api"
# TICKETING_API_KEY="your-external-ticketing-api-key"
