# Database
DATABASE_URL="postgresql://user:password@localhost:5432/b2b_saas?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS="http://localhost:3000"
# Set to false if hosting production over HTTP on local network
COOKIE_SECURE="true"

# Optional: internal impersonation signing secret
IMPERSONATION_SECRET="change-me-impersonation-secret-min-32-chars"

# Chatbot backend — Analytics Agent (SSE) on the same host; /api/chat proxies to it
AGENT_URL="http://localhost:8050"

# Legacy Ollama settings (the agent manages its own model now; used by the deploy preflight)
OLLAMA_URL="http://localhost:11435"
OLLAMA_MODEL="qwen2.5:3b"
