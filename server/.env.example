# Database
DATABASE_URL="postgresql://user:password@localhost:5432/b2b?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS — comma-separated list of allowed frontend origins (scheme + host + port).
# MUST include the exact origin the browser loads the app from. For a LAN deploy
# accessed by IP, use that IP (and include localhost too if you also test locally):
#   ALLOWED_ORIGINS="http://172.17.121.200:3000,http://localhost:3000"
# Use "*" to allow any origin (LAN/dev convenience; the origin is still reflected
# for credentialed requests).
ALLOWED_ORIGINS="http://localhost:3000"

# Comma-separated work-email domains for the software provider — only these may hold
# and log in with the ADMINISTRATOR role. REQUIRED: if empty, admin login is disabled
# (fail closed). Must include the domain of any seeded/provisioned admin.
# ⚠ Use PRIVATE work domains you control. NEVER list a public mailbox domain
# (gmail.com, outlook.com, yahoo.com, …): registration grants ADMINISTRATOR from
# the email domain, so any public-domain signup would become a platform super-admin.
ADMIN_DOMAINS="platform.com"

# Cookie Secure flag. MUST be "false" when serving over plain HTTP (e.g. a LAN IP),
# otherwise the browser silently drops the auth cookie and every login "fails".
# Set to "true" only when served over HTTPS.
COOKIE_SECURE="true"

# Optional: internal impersonation signing secret
IMPERSONATION_SECRET="change-me-impersonation-secret-min-32-chars"

# Encrypts Slack bot tokens, incoming-webhook URLs, and AD temporary passwords at
# rest (AES-256-GCM). OPTIONAL: falls back to JWT_ACCESS_SECRET when unset.
# ⚠ BACK THIS UP. If it is lost or changed, every previously encrypted bot token,
# webhook, and delivered AD credential becomes permanently undecryptable.
SLACK_TOKEN_SECRET="change-me-slack-token-secret-min-32-chars"

# Keys the HMAC-SHA256 fingerprint used to detect two accounts sharing the same
# password. It is a one-way keyed digest — the password is never recoverable from
# it. OPTIONAL: falls back to JWT_ACCESS_SECRET when unset.
# ⚠ KEEP IT STABLE. Changing it invalidates every stored fingerprint, so existing
# shared passwords stop being detected until those users next set a password.
PASSWORD_PEPPER="change-me-password-pepper-min-32-chars"

# Public URL of the frontend — used to build links in outgoing emails (password
# reset). Must be the exact origin users load the app from.
FRONTEND_URL="http://localhost:3000"

# Single-session enforcement: a session idle longer than this (minutes) no longer
# blocks a fresh login, so a closed browser can't lock the account for 7 days.
SESSION_INACTIVITY_MINUTES=30

# Chatbot backend — Analytics Agent (SSE) on the same host; /api/chat proxies to it
AGENT_URL="http://localhost:8001"

# ─── Agent signed /v1 API ─────────────────────────────────────────────────────
# The SAME agent server as AGENT_URL, reached through its documented HMAC-signed
# surface (/v1/chat, /v1/top-complaints) instead of the unsigned SSE stream. The
# agent serves everything on ONE port, 8001 — there is no second service to point
# at, even though older integration docs mention a :8002 chat service (retired).
# Leave AGENT_BASE_URL unset to inherit AGENT_URL above.
AGENT_BASE_URL="http://localhost:8001"

# Both credentials are issued from the Agent dashboard's Settings page
# (Administration role) and are SHOWN ONCE — copy them at generation time, they
# cannot be retrieved later, only replaced. They are separate credentials: a chat
# credential does not authenticate against top-complaints or vice versa.
#
# Leave a pair blank to disable that surface: the route then answers 503
# AGENT_NOT_CONFIGURED instead of sending an unsigned request that would 401.
#
# ⚠ Server-to-server only. These are password-equivalent — anyone holding one can
# call the agent as this application. Never expose them to a browser.

# Chat credential (client_id starts with `ext-`). Ask the agent administrator
# which audience roles it is allowed to request: the mapping in
# services/agentApi.ts (USER→end_user, ORG_ADMIN→l1, ADMINISTRATOR→l3) must sit
# inside that allowlist or requests come back role_not_allowed.
AGENT_CHAT_CLIENT_ID=""
AGENT_CHAT_SECRET=""

# Top-complaints credential (client_id starts with `dc-`). Read-only, no roles.
AGENT_COMPLAINTS_CLIENT_ID=""
AGENT_COMPLAINTS_SECRET=""

# NOTE: the agent's signatures reject a clock skew over 300s in EITHER direction,
# so this host must run NTP. A drifting clock shows up as intermittent
# stale_timestamp failures that look exactly like a signing bug.

# ─── Redis ───────────────────────────────────────────────────────────────────
# Backs the aggregate-read cache, the rate-limit store and the agent's
# one-call-at-a-time lock.
#
# OPTIONAL. Leave it unset and all three fall back to in-process behaviour: the
# cache calls straight through, limiters use a per-process memory store, and the
# agent lane serializes within this process only. That is fine for dev and for a
# single-process deployment; it is NOT fine once more than one API instance runs,
# because each would then enforce its own separate limits and agent lane.
# REDIS_URL="redis://localhost:6379"

# Which upstream addresses Express may believe an X-Forwarded-For header from.
# 'loopback' is correct when nginx runs on this same host (the bare-metal deploy).
# Under Podman, nginx reaches the API from its address on the container network,
# so set this to that network's CIDR — otherwise Express ignores the header and
# every IP-keyed rate limiter collapses into a single shared bucket, silently.
# NEVER set this to "true": that trusts a client-supplied header and makes the
# rate limiters bypassable by anyone who sends one.
TRUST_PROXY="loopback"

# Split databases — chat history and the ticketing tool each use their own DB
CHAT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_chat"
TICKETING_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_ticketing"

# Platform ADMINISTRATOR ticketing uses a SEPARATE database (same Ticket/Project
# schema as TICKETING_DATABASE_URL) so the provider's admins keep an isolated
# ticket store from org/user tickets. OPTIONAL: if unset, ADMINISTRATOR requests
# fall back to TICKETING_DATABASE_URL (no separate store). Create it with:
#   sudo -u postgres createdb b2b_ticketing_admin
#   cd server && npx prisma db push --schema prisma/ticketing.prisma   # after pointing the URL at it
ADMIN_TICKETING_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_ticketing_admin"

# Full Ticketing Platform database — the 14-table schema (Users/Customers/Projects/
# Tickets/SLAs/Comments/Activities/…) that backs the rebuilt ticketing module.
# Create + load with: server/prisma/ticketing-full-schema.sql, then introspect via
#   npx prisma db pull --schema prisma/ticket.prisma
TICKET_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_ticket"

# Mailing System (SMTP Config)
# REQUIRED in practice. Self-registration emails a confirmation link and login is
# gated on it, so with mail down NOBODY CAN REGISTER AND SIGN IN. It also carries
# the MFA code for accounts that have MFA on, password resets, and invitations.
# Verify with a real end-to-end registration + login.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="noreply@b2bsaas.com"

# Email MFA tuning. NOTE: MFA is OPT-IN, not mandatory — it applies when the user
# turns it on (User.mfaEnabled, default off) or an org admin enforces it for the
# whole organization (Customer.mfaRequired). It is NOT what proves a new user's
# email address; the registration confirmation link above does that.
# TTL of a code, max wrong attempts before the challenge is burned, resend cooldown.
MFA_CODE_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
MFA_RESEND_COOLDOWN_SECONDS=30

# ── Organization approval ────────────────────────────────────────────────────
# Self-registered organizations must be admitted by a staff member holding the
# `orgs.approve` permission (Administration + HR Admin by default). On email
# confirmation a 6-digit code is emailed to those people at their own addresses;
# they pass it to the new org's admin out of band, who types it in to finish.
# Organizations registering on an ADMIN_DOMAINS address skip this entirely.
#
# TTL is short because the handover happens during a live conversation; the org
# admin can request a fresh code, bounded by the resend cooldown.
ORG_APPROVAL_TTL_MINUTES=10
ORG_APPROVAL_MAX_ATTEMPTS=5
ORG_APPROVAL_RESEND_COOLDOWN_SECONDS=60

# ── Web Push (VAPID, RFC 8292) ───────────────────────────────────────────────
# Generate a key pair once with:  npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is a SECRET — keep it server-side only, never expose or log it.
# This pair is the ONLY place the key is configured — the browser fetches the
# public half from /api/push/vapid-public-key at runtime, so there is no client
# copy to keep in step and rotating the key needs no client rebuild.
# If these are unset, push sending is disabled (503) and the API logs a warning
# at startup. Rotating them unsubscribes every browser.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI the push services can reach you at (mailto: or https:).
VAPID_SUBJECT="mailto:admin@banihal.in"

# Directory for ticket/comment attachment uploads (local disk, relative to cwd).
# ⚠ Put this on a PERSISTENT volume in production — a rebuild/redeploy of the tree
# will otherwise lose uploaded files.
UPLOAD_DIR="uploads"

# External ticketing API (optional mirror/sync). The integration stays fully
# DISABLED while TICKETING_API_URL is unset — local tickets work standalone.
# TICKETING_API_URL="https://tickets.example.com/api"
# TICKETING_API_KEY="your-external-ticketing-api-key"
