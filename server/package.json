{
  "name": "b2b-saas-server",
  "version": "1.0.0",
  "description": "B2B SaaS multi-tenant API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run db:generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate && prisma generate --schema prisma/chat.prisma && prisma generate --schema prisma/ticketing.prisma && prisma generate --schema prisma/ticket.prisma",
    "db:provision": "bash db/provision.sh",
    "db:verify": "tsx db/verify.ts",
    "db:push": "echo 'db:push is deprecated and can wipe data — use db:provision (idempotent SQL DDL)' && npm run db:provision",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:tickets": "tsx prisma/seed-tickets.ts",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "chat:doctor": "NODE_EXTRA_CA_CERTS=cert/agent.pem tsx scripts/chat-doctor.ts",
    "backfill:tickets": "tsx scripts/backfill-ticket-org-codes.ts",
    "validate:escalations": "tsx scripts/validate-escalation-numbering.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.18.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.2",
    "pg": "^8.22.0",
    "rate-limit-redis": "^4.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.10.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^4.1.9"
  }
}
