generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  plan          Plan                  @default(FREE)
  suspended     Boolean               @default(false)
  ssoEnabled    Boolean               @default(false)
  mfaRequired   Boolean               @default(false)
  creditLimit   Int                   @default(1000)
  // ─── B2B / Cybersecurity fields ───────────────────────────────
  industry      String?
  contractValue Int                   @default(0)
  healthScore   Int                   @default(100)
  csm           String?
  // ──────────────────────────────────────────────────────────────
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  apiUsage      ApiUsage[]
  featureFlags  OrgFeatureFlag[]
  users         User[]
  requests      ServiceRequest[]
  services      OrganizationService[]

  @@index([slug])
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role           @default(USER)
  mfaEnabled     Boolean        @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizationId String
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  performedById  String
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())
  organizationId String
  performedBy    User     @relation(fields: [performedById], references: [id])

  @@index([organizationId])
  @@index([performedById])
  @@index([createdAt])
}

model ApiUsage {
  id             String       @id @default(cuid())
  organizationId String
  creditsUsed    Int          @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([periodStart])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model OrgFeatureFlag {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model ServiceRequest {
  id             String        @id @default(cuid())
  organizationId String
  type           RequestType   @default(SUPPORT)
  status         RequestStatus @default(OPEN)
  priority       Priority      @default(MEDIUM)
  subject        String
  description    String?
  service        String?
  assignedTo     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  resolvedAt     DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ─── Subscribed services per org, with renewal tracking ─────────────
// Super Admin can enable/disable each row; renewal date drives status.
model OrganizationService {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  status          ServiceStatus  @default(ACTIVE)
  enabled         Boolean        @default(true)
  monthlyPrice    Int            @default(0)
  purchasedAt     DateTime       @default(now())
  renewsAt        DateTime
  lastBilledAt    DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status])
  @@index([renewsAt])
}

enum Role {
  USER
  ORG_ADMIN
  SAAS_ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ServiceStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
}

enum RequestType {
  SUPPORT
  INCIDENT
  FEATURE_REQUEST
  ONBOARDING
  BILLING
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}
