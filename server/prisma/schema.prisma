generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  plan          Plan                  @default(FREE)
  suspended     Boolean               @default(false)
  ssoEnabled    Boolean               @default(false)
  mfaRequired   Boolean               @default(false)
  creditLimit   Int                   @default(1000)
  // ─── Primary contact details ──────────────────────────────────
  mailId        String
  contactPerson String
  contactNumber String
  domain        String?               @unique // derived from mailId (null for gmail.com); one org per domain
  // Short code embedded in ticket numbers when the format includes the org
  // (e.g. "DVB" → TKT-DVB-001). Auto-defaulted from the name; editable by an
  // ADMINISTRATOR. Unique so per-org ticket sequences never collide.
  orgCode       String?               @unique
  // ─── B2B / Cybersecurity fields ───────────────────────────────
  industry      String?
  contractValue Int                   @default(0)
  healthScore   Int                   @default(100)
  csm           String?
  // ──────────────────────────────────────────────────────────────
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  featureFlags  OrgFeatureFlag[]
  users         User[]
  requests      ServiceRequest[]
  services      CustomerService[]
  announcements Announcement[]
  escalations   TicketEscalation[]

  @@index([slug])
  @@map("customers")
}

// Global, platform-wide ticket-number format — a single row (id = "default"),
// editable only by an ADMINISTRATOR. Consumed by the ticketing module when it
// allocates a ticket number. Absent row ⇒ built-in defaults (TKT-001).
model TicketNumberSetting {
  id             String   @id @default("default")
  prefix         String   @default("TKT")
  includeOrgCode Boolean  @default(false)
  separator      String   @default("-")
  padWidth       Int      @default(3)
  updatedById    String?
  updatedAt      DateTime @updatedAt
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  mfaEnabled    Boolean        @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customerId    String
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailMfaChallenges  EmailMfaChallenge[]
  trustedDevices      TrustedDevice[]
  requests            ServiceRequest[] @relation("UserRequests")
  announcements       Announcement[] @relation("UserAnnouncements")
  escalations         TicketEscalation[] @relation("UserEscalations")
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
}

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  // Stable session identity: survives token rotation, carried in the access JWT
  // as `sid`. One active session per user is enforced at login.
  sessionId  String
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([sessionId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// Short-lived email MFA challenge. Issued after a password check at login; the
// emailed 6-digit code is stored hashed (never in plaintext). Verifying the code
// is what actually issues session tokens. One live challenge per user at a time.
model EmailMfaChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  lastSentAt DateTime  @default(now())
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Remember this device" — set after a successful MFA verify; a valid device
// cookie lets the SAME browser skip the email code on subsequent logins until
// it expires. The random token is stored hashed (SHA-256); the cookie carries
// `id.rawToken`. Revoked on password reset.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  performedById String?
  targetId      String?
  metadata      Json?
  createdAt     DateTime @default(now())
  customerId    String
  performedBy   User?    @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([performedById])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model OrgFeatureFlag {
  id         String   @id @default(cuid())
  customerId String
  key        String
  value      Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([customerId])
}

model ServiceRequest {
  id            String        @id @default(cuid())
  customerId    String
  createdById   String?
  type          RequestType   @default(SUPPORT)
  status        RequestStatus @default(OPEN)
  priority      Priority      @default(MEDIUM)
  subject       String
  description   String?
  service       String?
  assignedTo    String?
  // Platform-admin working notes — never returned on org-facing endpoints.
  internalNotes String?
  // External ticketing system reference (mirror + sync). Local rows stay the
  // app's source of truth; these track the mirrored ticket and last sync state.
  externalId        String?
  externalSyncedAt  DateTime?
  externalSyncError String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  resolvedAt    DateTime?
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("UserRequests", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// NOTE: Chat history (ChatSession/ChatMessage) moved to the dedicated chat
// database — see prisma/chat.prisma. Ticketing-tool tickets/projects live in
// the dedicated ticketing database — see prisma/ticketing.prisma. Both link
// back to this DB via customerId/userId in the service layer.

// ─── Ticket escalations (org admin → platform Administrators) ─────────────────
// Snapshot of a ticketing-tool ticket at the moment an ORG_ADMIN forwards it to
// the platform. Lives in our DB (not the external ticketing system) so it is
// cross-org queryable, survives restarts, and powers Administrator notifications.
model TicketEscalation {
  id            String           @id @default(cuid())
  customerId    String
  ticketId      String
  subject       String
  issueType     String
  priority      Priority         @default(MEDIUM)
  note          String?
  status        EscalationStatus @default(OPEN)
  escalatedById String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  escalatedBy   User?            @relation("UserEscalations", fields: [escalatedById], references: [id], onDelete: SetNull)

  @@unique([customerId, ticketId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ─── Platform announcements (broadcast by ADMINISTRATOR) ──────────────────────
// customerId null = visible to ALL organizations; set = targeted to one org.
// Listed in the tenant extension's globalModels — visibility is scoped manually
// in the announcements service (auto-injection would hide global rows).
model Announcement {
  id          String            @id @default(cuid())
  title       String
  message     String
  level       AnnouncementLevel @default(INFO)
  customerId  String?
  active      Boolean           @default(true)
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("UserAnnouncements", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([active])
}

// ─── Platform service catalog (global; managed by ADMINISTRATOR) ─────────────
model ServiceCatalog {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  basePrice   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@map("serviceCatalog")
}

// ─── Per-customer service (each org defines/manages its own services) ─────────
// endDate drives expiry status (ACTIVE / EXPIRING / EXPIRED), derived in code.
// Managed by the platform ADMINISTRATOR; customer-scoped for org members.
model CustomerService {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  description  String?
  monthlyPrice Int      @default(0)
  purchaseDate DateTime @default(now())
  endDate      DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([endDate])
  @@map("customerServices")
}

enum Role {
  USER
  ORG_ADMIN
  ADMINISTRATOR
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ServiceStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
}

enum RequestType {
  SUPPORT
  INCIDENT
  FEATURE_REQUEST
  ONBOARDING
  BILLING
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AnnouncementLevel {
  INFO
  WARNING
  CRITICAL
}

// ─── Slack bots (global; managed by ADMINISTRATOR) ───────────────────────────
// Each bot is a distinct "function" registered by an administrator. Tokens are
// stored ENCRYPTED (AES-256-GCM) and never returned to the client. `ticketUserId`
// is the bridged Users.id in the external b2b_ticket DB so the bot can be a ticket
// assignee. Live status is refreshed by the Slack manager's poll loop.
model SlackBot {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  botTokenEnc   String
  appTokenEnc   String?
  webhookUrlEnc String?
  apiKeyHash    String?
  apiKeyHint    String?
  botUserId     String?
  teamName      String?
  status        SlackBotStatus @default(DISCONNECTED)
  lastError     String?
  lastCheckedAt DateTime?
  ticketUserId  String?
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  formFields    SlackBotFormField[]
  orgs          SlackBotOrg[]

  @@map("slackBots")
}

// Admin-maintained dynamic ticket-form schema for a bot.
model SlackBotFormField {
  id          String       @id @default(cuid())
  botId       String
  key         String
  label       String
  type        BotFieldType @default(TEXT)
  required    Boolean      @default(false)
  options     Json?
  placeholder String?
  helpText    String?
  order       Int          @default(0)
  bot         SlackBot     @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, key])
  @@index([botId])
  @@map("slackBotFormFields")
}

// Which organizations may use a bot (per-org assignment). Tenant-scoped for org reads.
model SlackBotOrg {
  id         String   @id @default(cuid())
  botId      String
  customerId String
  createdAt  DateTime @default(now())
  bot        SlackBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, customerId])
  @@index([customerId])
  @@map("slackBotOrgs")
}

// Submitted dynamic-form values for a bot-assigned ticket (ticket lives in b2b_ticket).
model BotTicketSubmission {
  id           String   @id @default(cuid())
  botId        String
  customerId   String
  ticketId     String
  ticketNumber String
  values       Json
  createdById  String
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([botId])
  @@map("botTicketSubmissions")
}

enum SlackBotStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum BotFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  CHECKBOX
  USER_EMAIL
}

enum AdSecretStatus {
  PENDING
  DELIVERED
  VIEWED
  EXPIRED
}

// A temporary AD password delivered from a bot's AD automation for a specific
// bot ticket. The secret is AES-256-GCM encrypted at rest and revealable ONCE by
// each of the target user and the requesting org-admin; `secretEnc` is nulled the
// moment it is fully consumed or expires (24h). Tenant-scoped via customerId.
model AdCredentialDelivery {
  id               String         @id @default(cuid())
  botId            String
  customerId       String
  ticketId         String
  ticketNumber     String
  targetUserId     String?
  targetEmail      String
  requestedById    String
  secretEnc        String?
  status           AdSecretStatus @default(DELIVERED)
  viewedByTarget   Boolean        @default(false)
  viewedByRequester Boolean       @default(false)
  expiresAt        DateTime
  deliveredAt      DateTime       @default(now())
  viewedAt         DateTime?
  createdAt        DateTime       @default(now())

  @@index([customerId])
  @@index([targetUserId])
  @@index([requestedById])
  @@unique([botId, ticketNumber])
  @@map("adCredentialDeliveries")
}
