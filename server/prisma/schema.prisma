generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  plan          Plan                  @default(FREE)
  suspended     Boolean               @default(false)
  ssoEnabled    Boolean               @default(false)
  mfaRequired   Boolean               @default(false)
  creditLimit   Int                   @default(1000)
  // ─── Primary contact details ──────────────────────────────────
  mailId        String
  contactPerson String
  contactNumber String
  domain        String?               // derived from mailId (null for gmail.com)
  // ─── B2B / Cybersecurity fields ───────────────────────────────
  industry      String?
  contractValue Int                   @default(0)
  healthScore   Int                   @default(100)
  csm           String?
  // ──────────────────────────────────────────────────────────────
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  featureFlags  OrgFeatureFlag[]
  users         User[]
  requests      ServiceRequest[]
  services      CustomerService[]

  @@index([slug])
  @@map("customers")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  mfaEnabled    Boolean        @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customerId    String
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  performedById String
  targetId      String?
  metadata      Json?
  createdAt     DateTime @default(now())
  customerId    String
  performedBy   User     @relation(fields: [performedById], references: [id])

  @@index([customerId])
  @@index([performedById])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model OrgFeatureFlag {
  id         String   @id @default(cuid())
  customerId String
  key        String
  value      Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([customerId])
}

model ServiceRequest {
  id          String        @id @default(cuid())
  customerId  String
  type        RequestType   @default(SUPPORT)
  status      RequestStatus @default(OPEN)
  priority    Priority      @default(MEDIUM)
  subject     String
  description String?
  service     String?
  assignedTo  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  resolvedAt  DateTime?
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ─── Platform service catalog (global; managed by ADMINISTRATOR) ─────────────
model ServiceCatalog {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  basePrice   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@map("serviceCatalog")
}

// ─── Per-customer service (each org defines/manages its own services) ─────────
// endDate drives expiry status (ACTIVE / EXPIRING / EXPIRED), derived in code.
// Managed by the platform ADMINISTRATOR; customer-scoped for org members.
model CustomerService {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  description  String?
  monthlyPrice Int      @default(0)
  purchaseDate DateTime @default(now())
  endDate      DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([endDate])
  @@map("customerServices")
}

enum Role {
  USER
  ORG_ADMIN
  ADMINISTRATOR
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ServiceStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
}

enum RequestType {
  SUPPORT
  INCIDENT
  FEATURE_REQUEST
  ONBOARDING
  BILLING
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}
