[Unit]
Description=Tech B2B SaaS Frontend Client (Next.js)
After=network.target b2b-api.service
Documentation=https://github.com/Al-Ameen-BT/B2B-Site

[Service]
Type=simple
# User running the service — should be a dedicated unprivileged system user
User=b2bapp
WorkingDirectory=/opt/B2B-Site/client
# Loads environment variables from the client/.env file. The '-' prefix ignores the file if missing.
EnvironmentFile=-/opt/B2B-Site/client/.env
# Default environment variables
Environment=NODE_ENV=production
Environment=PORT=3000
# Run the compiled Next.js app directly under node to ensure correct SIGTERM propagation and graceful shutdown
ExecStart=/usr/bin/env node node_modules/.bin/next start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=b2b-web

# ─── Security Hardening (least-privilege sandbox) ─────────────────────────────
NoNewPrivileges=yes
ProtectSystem=full
# NOTE: Set ProtectHome=no if the application directory resides under /home/
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
