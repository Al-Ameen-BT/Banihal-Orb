[Unit]
Description=Tech B2B SaaS Unified Platform Service (Client & Server)
After=network.target postgresql.service
Documentation=https://github.com/Al-Ameen-BT/B2B-Site

[Service]
Type=simple
# Run under a dedicated unprivileged account — NEVER root in production. Create it once:
#   useradd --system --no-create-home --shell /usr/sbin/nologin b2bapp
#   chown -R b2bapp:b2bapp /opt/B2B-Site
User=b2bapp
WorkingDirectory=/opt/B2B-Site
ExecStart=/usr/bin/python3 /opt/B2B-Site/deploy_services.py --run
Restart=always
RestartSec=5
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=b2bweb

# ─── Hardening (least-privilege sandbox) ─────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
