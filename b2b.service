[Unit]
Description=Tech B2B SaaS Platform (API + Web)
After=network.target postgresql.service
Documentation=https://github.com/Al-Ameen-BT/B2B-Site

[Service]
Type=simple
# Dedicated unprivileged system user
User=b2bapp
# Both apps' env files are loaded. PORT is overridden per-process below (a single
# shared PORT would collide). Server secrets in the web process's env are harmless —
# Next only exposes NEXT_PUBLIC_* to the browser, and those are inlined at build time.
EnvironmentFile=-/opt/B2B-Site/server/.env
EnvironmentFile=-/opt/B2B-Site/client/.env
Environment=NODE_ENV=production

# One unit supervises BOTH processes: the Node API (:3001) and the Next server
# (:3000). Each runs in its own subshell with its own working directory and PORT. If
# EITHER child exits, the wrapper returns and Restart=always restarts the pair;
# SIGTERM is forwarded to both for a clean stop.
#
# NOTE: `$$` is how you write a literal `$` in a systemd ExecStart (otherwise systemd
# tries to expand it as one of its own variables).
ExecStart=/usr/bin/env bash -c ' \
    ( cd /opt/B2B-Site/server && exec env PORT=3001 node dist/server.js ) & api=$$!; \
    ( cd /opt/B2B-Site/client && exec env PORT=3000 node node_modules/.bin/next start ) & web=$$!; \
    trap "kill -TERM $$api $$web 2>/dev/null; exit 0" TERM INT; \
    wait -n; \
    kill -TERM $$api $$web 2>/dev/null; \
    wait'
Restart=always
RestartSec=5
# Give both children time to shut down gracefully before SIGKILL.
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=b2b

# ─── Security Hardening (least-privilege sandbox) ─────────────────────────────
NoNewPrivileges=yes
ProtectSystem=full
# NOTE: Set ProtectHome=no if the application directory resides under /home/
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
