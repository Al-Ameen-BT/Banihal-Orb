# Base URL of the API server. Requests are sent to `${NEXT_PUBLIC_API_URL}/api`.
# ⚠ NEXT_PUBLIC_* values are INLINED AT BUILD TIME — set this before `next build`,
# not just at runtime. In production, point it at the app's own public origin when
# the API is reverse-proxied under /api (e.g. https://app.example.com).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Web Push needs NOTHING here. The browser fetches the VAPID public key from
# /api/push/vapid-public-key at runtime, so only the server's VAPID_PUBLIC_KEY /
# VAPID_PRIVATE_KEY pair is configured. There is no build-time copy to keep in
# step, and rotating the key needs no client rebuild.
