# Slack credentials — app-level (xapp-) and bot (xoxb-) tokens must never be
# committed; paste them into the saas-admin bots UI / env config instead.
xapp-*
xoxb-*
*.token

# System files
.DS_Store
Thumbs.db

# Ticket/comment attachments — user-uploaded runtime data, never source.
# Point UPLOAD_DIR at a persistent path OUTSIDE the deploy tree in production.
server/uploads/
# Database backups — runtime data dumps, never source.
backup/
.claude
.agents