# Install with your actual machine DNS name, server certificate and client CA.
# Do not add machine locations to a non-mTLS listener. Do not publish port 3001.
limit_req_zone $binary_remote_addr zone=machine_ingress:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=machine_connections:10m;

server {
    listen 443 ssl;
    server_name machines.example.internal;
    ssl_certificate /etc/nginx/ssl/machines-fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/machines-key.pem;
    ssl_client_certificate /etc/nginx/ssl/machine-client-ca.pem;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_crl /etc/nginx/ssl/machine-clients.crl;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_early_data off;
    client_max_body_size 1m;
    client_body_timeout 15s;
    keepalive_timeout 30s;
    limit_conn machine_connections 10;

    location ~ ^/api/(proxy-agent/|bot-worker/[^/]+/(provision|heartbeat|message|request|state|command-result)$) {
        limit_req zone=machine_ingress burst=15 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Machine-Verified $ssl_client_verify;
        # Nginx's ssl_client_fingerprint is SHA1. Pass the verified certificate
        # so the backend computes SHA256 itself, rather than trusting a caller hash.
        proxy_set_header X-Machine-Certificate $ssl_client_escaped_cert;
        proxy_set_header Cookie "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
    }
    location / { return 404; }
}
