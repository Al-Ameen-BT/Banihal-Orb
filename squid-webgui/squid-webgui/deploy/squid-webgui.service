[Unit]
Description=Squid Web GUI
After=network.target squid.service

[Service]
User=squidui
Group=squidui
WorkingDirectory=/opt/squid-webgui
Environment=HOME=/opt/squid-webgui
Environment=SQUIDUI_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Port and SSL are configured in config.py (read by gunicorn_conf.py)
ExecStart=/opt/squid-webgui/venv/bin/gunicorn -c gunicorn_conf.py app:app
Restart=on-failure
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
