<!-- BT Proxy (Banihal Technologies LLP) - Wazuh rules
     Install: copy to /var/ossec/etc/rules/btproxy_rules.xml
              chown wazuh:wazuh, then: systemctl restart wazuh-manager
     Rule IDs 110200-110229 (custom range).
     Pairs with btproxy_decoders.xml (which populates srcuser, action, srcip).
     Uses <action> top-level matching, matching the deployed decoder.        -->

<group name="btproxy,proxy,">

  <rule id="110200" level="3">
    <decoded_as>btproxy</decoded_as>
    <description>BT Proxy: audit event</description>
  </rule>

  <!-- ===== Authentication ===== -->
  <rule id="110201" level="5">
    <if_sid>110200</if_sid>
    <action>^login-fail$</action>
    <description>BT Proxy: failed GUI login (user=$(srcuser))</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="110202" level="10" frequency="5" timeframe="300">
    <if_matched_sid>110201</if_matched_sid>
    <description>BT Proxy: possible brute force - 5 failed logins in 5 minutes</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="110203" level="8">
    <if_sid>110200</if_sid>
    <action>^login-locked$</action>
    <description>BT Proxy: account/IP locked out after repeated failures</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="110204" level="5">
    <if_sid>110200</if_sid>
    <action>^mfa-fail$</action>
    <description>BT Proxy: wrong MFA code (user=$(srcuser))</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="110205" level="3">
    <if_sid>110200</if_sid>
    <action>^login$</action>
    <description>BT Proxy: successful login (user=$(srcuser))</description>
    <group>authentication_success,</group>
  </rule>

  <!-- ===== Access / policy changes ===== -->
  <rule id="110206" level="7">
    <if_sid>110200</if_sid>
    <action>^fullaccess-add$</action>
    <description>BT Proxy: full unrestricted access GRANTED ($(extra_data)) by $(srcuser)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110207" level="5">
    <if_sid>110200</if_sid>
    <action>^fullaccess-remove$</action>
    <description>BT Proxy: full access removed ($(extra_data)) by $(srcuser)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110208" level="6">
    <if_sid>110200</if_sid>
    <action>^acl-add$</action>
    <description>BT Proxy: site added to a list by $(srcuser): $(extra_data)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110209" level="6">
    <if_sid>110200</if_sid>
    <action>^acl-remove-bulk$</action>
    <description>BT Proxy: sites removed from a list by $(srcuser): $(extra_data)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110210" level="6">
    <if_sid>110200</if_sid>
    <action>^branch-create$</action>
    <description>BT Proxy: access rule/branch created by $(srcuser): $(extra_data)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110211" level="6">
    <if_sid>110200</if_sid>
    <action>^branch-delete$</action>
    <description>BT Proxy: access rule/branch deleted by $(srcuser): $(extra_data)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110212" level="6">
    <if_sid>110200</if_sid>
    <action>^port-add$</action>
    <description>BT Proxy: port opened by $(srcuser): $(extra_data)</description>
    <group>policy_changed,</group>
  </rule>

  <!-- ===== Security-critical ===== -->
  <rule id="110213" level="12">
    <if_sid>110200</if_sid>
    <action>^license-tamper$</action>
    <description>BT Proxy: LICENSE TAMPERING - system clock rollback detected</description>
    <group>policy_changed,system_error,</group>
  </rule>

  <rule id="110214" level="12">
    <if_sid>110200</if_sid>
    <action>^factory-reset$</action>
    <description>BT Proxy: FACTORY RESET performed by $(srcuser) - all config erased</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110215" level="10">
    <if_sid>110200</if_sid>
    <action>^backup-restore$</action>
    <description>BT Proxy: configuration RESTORED from backup by $(srcuser)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110216" level="7">
    <if_sid>110200</if_sid>
    <action>^update-apply$</action>
    <description>BT Proxy: software update applied by $(srcuser)</description>
    <group>policy_changed,</group>
  </rule>

  <!-- ===== User & account management ===== -->
  <rule id="110217" level="6">
    <if_sid>110200</if_sid>
    <action>^user-create$</action>
    <description>BT Proxy: user account created by $(srcuser): $(extra_data)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110218" level="6">
    <if_sid>110200</if_sid>
    <action>^user-delete$</action>
    <description>BT Proxy: user account deleted by $(srcuser): $(extra_data)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110219" level="5">
    <if_sid>110200</if_sid>
    <action>^mfa-reset$</action>
    <description>BT Proxy: MFA reset for a user by $(srcuser)</description>
    <group>policy_changed,</group>
  </rule>

  <rule id="110220" level="3">
    <if_sid>110200</if_sid>
    <action>^logout$</action>
    <description>BT Proxy: logout (user=$(srcuser))</description>
    <group>authentication_success,</group>
  </rule>

</group>
